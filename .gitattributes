* text=auto eol=lf

# Markdown is prose and excluded from the language statistics by default. This repository is
# documentation, so it is what the statistics should report.
*.md                       linguist-detectable=true

# Tooling scripts, not what this repository is written in. Without this the language
# statistics report the organization landing page as a Python project.
/.claude/**/*.py           linguist-vendored
/doc/scripts/**/*.py       linguist-vendored

# Exported from dependency-graph.excalidraw, not authored by hand.
/doc/dependency-graph.svg  linguist-generated
